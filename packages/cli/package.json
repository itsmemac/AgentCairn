  "description": "The cairn command: link projects to a shared memory and wire Agent Cairn into Claude Code.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "mcp",
    "cli",
    "ai-agents",
    "memory"
  ],
  "homepage": "https://github.com/itsmemac/agentcairn#readme",
  "bugs": {
