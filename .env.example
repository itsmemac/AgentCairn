# Copy to .env and adjust. Never commit .env.
# See docs/configuration.md for every setting.

# --- Neo4j ---------------------------------------------------------------
# Used by the server and, with `--profile with-neo4j`, by the bundled Neo4j container.
NEO4J_PASSWORD=change-me-please

# Using your own Neo4j instead of the bundled one? Point the server at it
# (inside Docker, "localhost" is the container itself: use the host's address).
# NEO4J_URI=bolt://your-neo4j-host:7687
# NEO4J_USER=neo4j

# Running the tests, or the local stdio server, on your own machine against a
# local Neo4j (for example `docker run -p 7687:7687 -e NEO4J_AUTH=neo4j/change-me-please neo4j:5-community`):
# NEO4J_URI=bolt://localhost:7687

# --- Server ----------------------------------------------------------------
# Port the dashboard and the MCP endpoint listen on.
# CAIRN_PORT=8787
# Keep request and response payloads for the dashboard ("full") or only a summary ("meta").
# CAIRN_CAPTURE=full
# Behind a reverse proxy that sets X-Forwarded-For / terminates TLS:
# CAIRN_TRUST_PROXY=1
# CAIRN_COOKIE_SECURE=1
# Optional static token. Normally leave this out and create tokens in the dashboard (Access).
# CAIRN_TOKEN=
# Only on a network you fully trust, to run without any authentication:
# CAIRN_NO_AUTH=1

# --- Clients (the machines where your agents run) ---------------------------
# Address of the server, without a trailing slash or /mcp. Read by the `cairn` CLI
# and expanded by Claude Code in .mcp.json. Set these in your shell or OS environment.
# CAIRN_URL=http://localhost:8787
# CAIRN_TOKEN=aib_...   # a token created in the dashboard
